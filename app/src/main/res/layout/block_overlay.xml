<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/shield_overlay_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/overlay_card_bg">

            <FrameLayout
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:layout_marginBottom="24dp"
                android:background="@drawable/badge_circle_bg">

                <ImageView
                    android:id="@+id/overlay_icon"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_shield_badge"
                    android:contentDescription="@string/app_name" />

            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:gravity="center"
                android:text="@string/overlay_label"
                android:textColor="@color/shield_accent"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.15"
                android:textAllCaps="true" />

            <TextView
                android:id="@+id/overlay_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp"
                android:gravity="center"
                android:text="@string/overlay_title"
                android:textColor="@color/shield_overlay_text"
                android:textSize="24sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/overlay_close_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minWidth="200dp"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:background="@drawable/button_close_selector"
                android:textColor="@color/button_close_text_color"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textStyle="bold"
                android:stateListAnimator="@null"
                android:elevation="0dp"
                android:text="@string/overlay_close"
                android:enabled="false" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
